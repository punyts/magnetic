# The beta as the host runs it (infra/aws/host-deploy.sh), for `npm run magnetic:beta` and `magnetic:beta-full` from
# the workspace. Development only: no real secrets. The seed (--seed) adds its admin, avery@magnetic.test, to the admins.
MAGNETIC_SECRET_KEY=local-beta-secret-not-for-the-host
MAGNETIC_BETA_ORG=beta
MAGNETIC_USER_ALLOWANCE=5
MAGNETIC_ALLOWANCE_USERS=100
MAGNETIC_DAILY_BUDGET=off
MAGNETIC_MONTHLY_BUDGET=550
MAGNETIC_BETA_BUDGET=500
MAGNETIC_INTERNAL_ORG=ai-minion
MAGNETIC_INTERNAL_BUDGET=50
MAGNETIC_EMBEDDING=hash
